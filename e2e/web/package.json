{
  "name": "playwright-web",
  "scripts": {
    "playwright:test": "playwright test",
    "playwright:test:chrome": "playwright test --project=chromium",
    "playwright:ui": "playwright test --ui",
    "playwright:report": "playwright show-report playwright-report",
    "playwright:merge-reports": "playwright merge-reports",
    "playwright:monocart:report": "monocart show-report test-results/report.html",
    "playwright:init": "playwright install",
    "playwright:init:deps": "playwright install --with-deps"
  },
  "dependencies": {
    "@playwright/test": "1.60.0",
    "dotenv-safe": "9.1.0"
  },
  "devDependencies": {
    "@types/dotenv-safe": "8.1.6",
    "monocart-reporter": "2.11.2"
  }
}
