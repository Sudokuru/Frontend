{
  "name": "sudokuru-frontend",
  "version": "1.0.0",
  "main": "./app/App.tsx",
  "scripts": {
    "start": "expo start --clear",
    "start:atlas": "cross-env EXPO_ATLAS=true expo start --clear",
    "start:atlas:prod": "cross-env EXPO_ATLAS=true expo start --clear --no-dev",
    "start:tunnel": "expo start --tunnel --clear",
    "android": "expo start --android --clear",
    "ios": "expo start --ios --clear",
    "web": "npx expo start --web --clear",
    "web:dev": "cross-env ENV=development npx expo start --web --clear",
    "web:prod": "npx expo start --web --clear --no-dev --minify",
    "web:serve:prod": "npm run build:metro-web && npx serve dist -l 8081",
    "build:metro-web": "npx expo export --platform web --dump-sourcemap",
    "test": "bun test",
    "tauri:run": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "expo:check": "npx expo install --check",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/metro-runtime": "58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-vector-icons/material-design-icons": "13.1.3",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/drawer": "7.14.4",
    "@react-navigation/elements": "2.9.45",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/stack": "7.12.1",
    "expo": "58.0.19",
    "expo-font": "58.0.10",
    "expo-linear-gradient": "58.0.3",
    "expo-status-bar": "58.0.4",
    "polished": "^4.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-paper": "5.15.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "sudokuru": "3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@tauri-apps/cli": "^2.9.6",
    "@types/node": "^20.11.17",
    "@types/react": "19.3.0",
    "@types/react-native-web": "0.19.0",
    "babel-plugin-istanbul": "^6.1.1",
    "bun": "1.4.2",
    "cross-env": "^7.0.3",
    "expo-atlas": "0.5.0",
    "expo-doctor": "1.21.5"
  },
  "private": true
}
